(module Test_Legacy (layer F.Cu) (tedit 5A02FF57)
  (descr "Synthetic legacy footprint")
  (tags legacy)
  (attr virtual)
  (fp_text reference REF** (at 0 -2) (layer F.SilkS)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value Test_Legacy (at 0 2) (layer F.Fab) hide
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_line (start -1 -1) (end 1 -1) (layer F.SilkS) (width 0.12))
  (fp_circle (center 0 0) (end 1 0) (layer F.Fab) (width 0.1))
  (fp_arc (start 0 0) (end 1 0) (angle 90) (layer F.Fab) (width 0.1))
  (pad 1 thru_hole rect (at 0 0) (size 1.5 1.5) (drill 0.8) (layers *.Cu *.Mask))
  (model ${KISYS3DMOD}/Test.3dshapes/Test_Legacy.wrl
    (at (xyz 0 0 0))
    (scale (xyz 1 1 1))
    (rotate (xyz 0 0 0))
  )
)
